{
  "permissions": {
    "allow": [
      "Read"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/context-injector.mjs claude" },
          { "type": "command", "command": "echo same-group" }
        ]
      },
      { "matcher": "x", "hooks": [ { "type": "command", "command": "node ./scripts/context-injector.mjs claude" } ] },
      {
        "hooks": [
          { "type": "command", "command": "node /srv/app/scripts/context-injector.mjs claude" },
          { "type": "command", "command": "node tools/context-injector.mjs-wrapper/run.mjs" },
          { "type": "command", "command": "my-context-injector.mjs-tool.sh" },
          { "type": "command", "command": { "path": "scripts/context-injector.mjs" } }
        ]
      },
      { "matcher": "y", "hooks": [ { "type": "command", "command": "echo other-group" } ] }
    ],
    "PreToolUse": [ { "hooks": [ { "type": "command", "command": "echo pre" } ] } ]
  },
  "env": { "PONYTAIL_SUBAGENT_MATCHER": "implementer", "FOO": "1" }
}
